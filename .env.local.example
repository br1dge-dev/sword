# Environment Variables for GR1FTSWORD
# Copy this to .env.local and fill in your values

# ============================================
# REQUIRED FOR SIGNATURE GENERATION
# ============================================
# This private key signs EIP-712 messages for claim eligibility
# Must be the same as the contract owner address
# ⚠️ NEVER commit the real private key to git!
SIGNER_PRIVATE_KEY=0x...

# ============================================
# CONTRACT ADDRESSES (filled after deployment)
# ============================================
# Base Sepolia (testnet)
CONTRACT_ADDRESS_BASE_SEPOLIA=0x...

# Base Mainnet (production)
CONTRACT_ADDRESS_BASE=0x...

# ============================================
# OPTIONAL: FOR DEPLOYMENT SCRIPTS
# ============================================
# Your deployer private key (for Foundry scripts)
PRIVATE_KEY=0x...

# RPC URLs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=...

# ============================================
# VERCEL (auto-filled in production)
# ============================================
# These are automatically set by Vercel
# VERCEL_ENV=production
# VERCEL_URL=...
# VERCEL_GIT_COMMIT_SHA=...
